---
import Base from '../layouts/Base.astro'
import { appConfig } from '../../../app.config'

const description =
  'A SaaS starter with static public pages, an application shell, and a read-only API on one Cloudflare Worker.'
const canonical = new URL('/', appConfig.app.url).href
---

<Base title={appConfig.app.name} description={description} canonical={canonical}>
  <main id="content">
    <section class="hero">
      <div>
        <h1>A SaaS shell on one Worker.</h1>
        <p class="lede">
          Public pages are built as HTML. The product lives at <a href="/app">/app</a>. Signing in
          opens a session stored in D1.
        </p>
        <div class="actions">
          <a class="button button-primary" href="/pricing">View pricing</a>
          <a class="button button-ghost" href="/app">Open the app</a>
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="stage-bar">
          <span class="live"></span>
          <span class="stage-path">/app</span>
        </div>
        <div class="mini">
          <div class="mini-side">
            <span class="mini-on">Home</span>
            <span>Settings</span>
          </div>
          <div class="mini-main">
            <p class="mini-title">Sign in to continue.</p>
            <p class="mini-row"><span>Schema</span><b>2</b></p>
            <p class="mini-row"><span>Plugins</span><b>auth</b></p>
          </div>
        </div>
      </div>
    </section>
    <section class="facts" aria-label="What this Worker serves">
      <div>
        <h2>Public pages</h2>
        <p>Home and pricing are static HTML. They do not read the database.</p>
      </div>
      <div>
        <h2>Application</h2>
        <p>
          The product starts at <a href="/app">/app</a>. Refreshing a deep link stays in the shell.
        </p>
      </div>
      <div>
        <h2>API</h2>
        <p>Reads return the app name and enabled plugins. Writes require a session.</p>
      </div>
    </section>
  </main>
</Base>
