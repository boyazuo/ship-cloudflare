{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ship-saas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  // Template traffic is tiny. Lower the traces sample before a real domain takes production traffic.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "vars": {
    "APP_ENV": "development",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/app", "/app/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ship-saas-local-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": { "APP_ENV": "staging" },
      "routes": [{ "pattern": "staging.example.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": ["/api/*", "/app", "/app/*"],
      },
      // Replace database_id with the UUID from `wrangler d1 create ship-saas-staging-db` before deploy.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ship-saas-staging-db",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "workers_dev": false,
      "vars": { "APP_ENV": "production" },
      "routes": [{ "pattern": "www.example.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": ["/api/*", "/app", "/app/*"],
      },
      // Replace database_id with the UUID from `wrangler d1 create ship-saas-production-db` before deploy.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ship-saas-production-db",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
