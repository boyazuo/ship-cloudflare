---
import Base from '../layouts/Base.astro'
import { site } from '../site'

const description = 'That page is not part of this site.'
const canonical = new URL('/404', site.url).href
---

<Base title={`Not found · ${site.name}`} description={description} canonical={canonical}>
  <main id="content" class="miss">
    <p class="count">404</p>
    <h1>Not found</h1>
    <p class="lede">This URL is not a published page. The response status is 404.</p>
    <div class="actions">
      <a class="button button-primary" href="/">Back home</a>
    </div>
  </main>
</Base>
