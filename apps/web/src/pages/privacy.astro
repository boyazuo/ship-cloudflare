---
import Base from '../layouts/Base.astro'
import { site } from '../site'

const description = 'What this content site stores. It does not keep personal information.'
const canonical = new URL('/privacy', site.url).href
---

<Base title={`Privacy · ${site.name}`} description={description} canonical={canonical}>
  <main id="content" class="prose">
    <h1>Privacy</h1>
    <p class="lede">
      This site publishes static pages. It does not keep personal information.
    </p>
    <h2>What is stored</h2>
    <p>
      Nothing about a visitor. Each page is HTML that already exists before a request. The <a
        href="/tools/counter">counter</a
      > changes a number in the browser and drops it on refresh.
      That number is not sent to a server.
    </p>
    <h2>Cookies</h2>
    <p>
      The template does not set cookies and does not run analytics. A page request is answered with
      a file.
    </p>
    <p>
      The <a href="/terms">terms</a> describe the site as published. A deployment that starts keeping
      personal information has to rewrite this page first.
    </p>
  </main>
</Base>
