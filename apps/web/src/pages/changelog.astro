---
import Base from '../layouts/Base.astro'
import { site } from '../site'

const description = 'What has shipped on this content site.'
const canonical = new URL('/changelog', site.url).href
---

<Base title={`Changelog · ${site.name}`} description={description} canonical={canonical}>
  <main id="content">
    <h1>Changelog</h1>
    <p class="lede">A short record of the site. These pages do not read a database.</p>
    <ol class="log">
      <li>
        <time datetime="2026-11-15">Nov 15, 2026</time>
        <div>
          <h2>Pages</h2>
          <p>
            Home, the <a href="/guide">guide</a>, <a href="/notes">notes</a>, and this page are
            static HTML.
          </p>
        </div>
      </li>
      <li>
        <time datetime="2026-11-15">Nov 15, 2026</time>
        <div>
          <h2>Counter</h2>
          <p>
            The <a href="/tools/counter">counter</a> runs in the browser. Refreshing resets the
            number.
          </p>
        </div>
      </li>
    </ol>
  </main>
</Base>
