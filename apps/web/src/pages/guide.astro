---
import Base from '../layouts/Base.astro'
import { site } from '../site'

const description = 'How this content site uses static pages, and where a simple tool stops.'
const canonical = new URL('/guide', site.url).href
---

<Base title={`Guide · ${site.name}`} description={description} canonical={canonical}>
  <main id="content" class="prose">
    <h1>What belongs on this site.</h1>
    <p class="lede">
      Publish writing here. The HTML exists before the first request, so a reader and a crawler see
      the same document.
    </p>
    <h2>A simple tool</h2>
    <p>
      The <a href="/tools/counter">counter</a> is the pattern for a small tool. It is one page, the
      first number is in the HTML, and the buttons only change that page. Refreshing starts over.
      Nothing is sent to a server.
    </p>
    <h2>What moves to SaaS</h2>
    <p>
      A tool that needs an account, a payment, or data this project owns is no longer a page on this
      site. Build that in the SaaS template, behind the application shell.
    </p>
  </main>
</Base>
