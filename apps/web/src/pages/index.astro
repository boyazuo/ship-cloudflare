---
import Base from '../layouts/Base.astro'
import { site } from '../site'

const canonical = new URL('/', site.url).href
---

<Base title={site.name} description={site.description} canonical={canonical} wide>
  <main id="content">
    <section class="hero">
      <div>
        <h1>Pages, published as HTML.</h1>
        <p class="lede">
          Each public URL is a document that already exists. A small tool can live on its own page.
          Accounts, payments, and stored data belong in the SaaS template.
        </p>
        <div class="actions">
          <a class="button button-primary" href="/guide">Read the guide</a>
          <a class="button button-ghost" href="/tools/counter">Open the counter</a>
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="stage-bar">
          <span class="live"></span>
          <span class="stage-path">/</span>
          <span class="stage-code">200</span>
        </div>
        <div class="stage-doc">
          <p class="stage-h">Pages, published as HTML.</p>
          <p class="stage-p">The file is on the edge before anyone requests it.</p>
        </div>
      </div>
    </section>
    <section class="facts" aria-label="What this site is for">
      <div>
        <h2>Built first</h2>
        <p>The HTML exists before the first request. A reader and a crawler see the same page.</p>
      </div>
      <div>
        <h2>Stays in the browser</h2>
        <p>
          The <a href="/tools/counter">counter</a> only changes the number on its page. Refreshing
          starts over.
        </p>
      </div>
      <div>
        <h2>Leaves this site</h2>
        <p>A tool that needs an account, a payment, or stored data moves to the SaaS template.</p>
      </div>
    </section>
  </main>
</Base>
